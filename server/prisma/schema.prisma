generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Juego {
  FC25
  COD_BO2
}

enum EstadoPagoInscripcion {
  PENDIENTE_PAGO
  PAGADA
}

model Inscripcion {
  id                   String   @id @default(uuid())
  nombreCompleto       String
  nickname             String?
  nicknameNormalizado  String?
  documento            String?
  juego                Juego
  estadoPago           EstadoPagoInscripcion @default(PENDIENTE_PAGO)
  createdAt            DateTime @default(now())
  pago                 Pago?

  // COD BO2 team fields
  jugador1Nombre       String?
  jugador2Nombre       String?
  ficha                String?
  programa             String?
  correo               String?
  telefono             String?
  nickEquipo           String?

  @@unique([juego, nicknameNormalizado])
  @@unique([juego, documento])
}

enum MetodoPago {
  SIN_SELECCION
  EPAYCO
  EFECTIVO
}

enum EstadoPago {
  PENDIENTE
  EN_PROCESO
  PAGADO
  RECHAZADO
  FALLIDO
}

enum TipoEventoPago {
  CREADO
  METODO_EFECTIVO
  SESION_EPAYCO_CREADA
  WEBHOOK_RECIBIDO
  WEBHOOK_INVALIDO
  PAGO_CONFIRMADO
  PAGO_RECHAZADO
  PAGO_FALLIDO
  EFECTIVO_CONFIRMADO
}

model Pago {
  id                   String      @id @default(uuid())
  inscripcionId        String      @unique
  inscripcion          Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  monto                Decimal     @db.Decimal(10, 2)
  moneda               String      @default("COP")
  metodo               MetodoPago  @default(SIN_SELECCION)
  estado               EstadoPago  @default(PENDIENTE)
  referenciaInterna    String      @unique
  epaycoSessionId      String?
  epaycoRefPayco       String?
  epaycoTransactionId  String?     @unique
  epaycoResponse       String?
  epaycoFranchise      String?
  fechaConfirmacion    DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  eventos              EventoPago[]
}

model EventoPago {
  id        String         @id @default(uuid())
  pagoId    String
  pago      Pago           @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  tipo      TipoEventoPago
  detalle   Json?
  createdAt DateTime       @default(now())
}

model EstadoInscripciones {
  juego     Juego    @id
  abierta   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

enum FormatoBracket {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
}

enum LadoBracket {
  WINNERS
  LOSERS
}

model Bracket {
  id        String         @id @default(uuid())
  juego     Juego          @unique
  formato   FormatoBracket
  createdAt DateTime       @default(now())
  partidos  Partido[]
}

model Partido {
  id               String       @id @default(uuid())
  bracketId        String
  bracket          Bracket      @relation(fields: [bracketId], references: [id])
  ronda            Int
  lado             LadoBracket?
  jugadorAId       String?
  jugadorBId       String?
  scoreA           Int?
  scoreB           Int?
  penaltyScoreA    Int?
  penaltyScoreB    Int?
  winnerId         String?
  nextMatchId      String?
  nextLoserMatchId String?
  resolvedAt       DateTime?
}

// ─── Fase de grupos ───────────────────────────────────────────────────────────

enum EstadoFaseGrupos {
  PENDIENTE   // grupos creados, sin resultados
  EN_CURSO    // al menos un partido jugado
  FINALIZADA  // todos los partidos jugados, clasificados determinados
}

model FaseGrupos {
  id        String           @id @default(uuid())
  juego     Juego            @unique
  estado    EstadoFaseGrupos @default(PENDIENTE)
  createdAt DateTime         @default(now())
  grupos    Grupo[]
}

model Grupo {
  id             String          @id @default(uuid())
  faseId         String
  fase           FaseGrupos      @relation(fields: [faseId], references: [id])
  nombre         String          // "Grupo A", "Grupo B", …
  participantes  GrupoParticipante[]
  partidos       PartidoGrupo[]
}

// Las estadísticas (puntos, PJ-PG-PE-PP, goles) no se almacenan:
// se calculan siempre desde los resultados de PartidoGrupo al leer.
model GrupoParticipante {
  id             String  @id @default(uuid())
  grupoId        String
  grupo          Grupo   @relation(fields: [grupoId], references: [id])
  inscripcionId  String  // referencia lógica a Inscripcion.id
  clasificado    Boolean @default(false)
}

model PartidoGrupo {
  id          String    @id @default(uuid())
  grupoId     String
  grupo       Grupo     @relation(fields: [grupoId], references: [id])
  ronda       Int?      // ronda del round-robin (metodo circular); null en partidos generados antes de este campo
  jugadorAId  String    // inscripcionId
  jugadorBId  String
  scoreA      Int?
  scoreB      Int?
  winnerId    String?   // null si empataron
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}
